async function sendNotification(db, env, notification) {
  const owner = notification.kind === "owner";
  const language = owner ? "bg" : notification.language;
  const { results: items } = await db.prepare("SELECT oi.quantity, oi.unit_price_cents AS unitPriceCents, b.title_bg AS titleBg, b.title_en AS titleEn, b.id FROM order_items oi JOIN books b ON b.id = oi.book_id WHERE oi.order_id = ? ORDER BY b.sort_order").bind(notification.order_id).all();
  const lines = items.map((item) => `${item.titleBg && language === "bg" ? item.titleBg : item.titleEn || item.titleBg || item.id} \xD7 ${item.quantity} \u2014 ${money(item.unitPriceCents * item.quantity, language)}`);
  const courier = notification.courier === "speedy" ? "\u0421\u043F\u0438\u0434\u0438 / Speedy" : "\u0415\u043A\u043E\u043D\u0442 / Econt";
  const text = owner ? [`\u041D\u043E\u0432\u0430 \u0437\u0430\u044F\u0432\u043A\u0430 \u0437\u0430 \u043F\u043E\u0440\u044A\u0447\u043A\u0430: ${notification.order_id}`, "", `\u041A\u043B\u0438\u0435\u043D\u0442: ${notification.customer_name}`, `\u0418\u043C\u0435\u0439\u043B: ${notification.customer_email}`, `\u0422\u0435\u043B\u0435\u0444\u043E\u043D: ${notification.customer_phone || "\u2014"}`, `\u041A\u0443\u0440\u0438\u0435\u0440: ${courier}`, `\u0410\u0434\u0440\u0435\u0441: ${notification.delivery_address}, ${notification.delivery_city}, ${notification.delivery_postal_code}`, `\u0411\u0435\u043B\u0435\u0436\u043A\u0430: ${notification.note || "\u2014"}`, "", ...lines, "", `\u041E\u0431\u0449\u043E \u0437\u0430 \u043A\u043D\u0438\u0433\u0438: ${money(notification.total_cents, "bg")}`, "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430\u0442\u0430 \u0438 \u043F\u043B\u0430\u0449\u0430\u043D\u0435\u0442\u043E \u0441\u0435 \u0443\u0442\u043E\u0447\u043D\u044F\u0432\u0430\u0442 \u0434\u043E\u043F\u044A\u043B\u043D\u0438\u0442\u0435\u043B\u043D\u043E."].join("\n") : language === "en" ? [`Hello ${notification.customer_name},`, "", `We received your order request ${notification.order_id}. We will contact you to confirm availability, delivery and payment. No payment has been taken.`, "", ...lines, "", `Books subtotal: ${money(notification.total_cents, "en")}`, `Courier: ${courier}`, `Delivery address: ${notification.delivery_address}, ${notification.delivery_city}, ${notification.delivery_postal_code}`].join("\n") : [`\u0417\u0434\u0440\u0430\u0432\u0435\u0439\u0442\u0435, ${notification.customer_name},`, "", `\u041F\u043E\u043B\u0443\u0447\u0438\u0445\u043C\u0435 \u0437\u0430\u044F\u0432\u043A\u0430\u0442\u0430 \u0432\u0438 ${notification.order_id}. \u0429\u0435 \u0441\u0435 \u0441\u0432\u044A\u0440\u0436\u0435\u043C \u0441 \u0432\u0430\u0441 \u0437\u0430 \u043F\u043E\u0442\u0432\u044A\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u043D\u0430 \u043D\u0430\u043B\u0438\u0